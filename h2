function ok(string $msg): void  { echo "\033[32m{$msg}\033[0m\n"; }
function info(string $msg): void { echo "\033[33m{$msg}\033[0m\n"; }
function fail(string $msg): void { echo "\033[31m错误：{$msg}\033[0m\n"; exit(1); }
